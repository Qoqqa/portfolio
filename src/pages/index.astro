---
import WelcomeScreen from '../components/WelcomeScreen.astro';
import ClientHeader from '../components/ClientHeader.astro';
import ClientSidebar from '../components/ClientSidebar.astro';
import PortfolioPanels from '../components/PortfolioPanels.astro';
import ClientFooter from '../components/ClientFooter.astro';
import '../styles/client.css';
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="RJ Colarina — Software Engineer building thoughtful digital experiences." />
    <title>RJ Colarina — Software Engineer</title>
  </head>
  <body>
    <WelcomeScreen />
    <div class="client-window">
      <div class="window-chrome" aria-hidden="true"><span></span><span></span><span></span><b>RJ COLARINA</b></div>
      <div class="noise" aria-hidden="true"></div>
      <ClientHeader />
      <ClientSidebar />
      <main id="top"><PortfolioPanels /></main>
      <ClientFooter />
    </div>
  </body>
</html>

<script>
  import '../scripts/client-navigation';
</script>
