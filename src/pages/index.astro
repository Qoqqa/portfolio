---
const projects = [
  {
    number: '01',
    title: 'Project One',
    description: 'Replace this with a short, outcome-focused description of your strongest project.',
    tags: ['TypeScript', 'React', 'API'],
    href: '#contact',
  },
  {
    number: '02',
    title: 'Project Two',
    description: 'Show how you solve meaningful problems through thoughtful engineering and design.',
    tags: ['Astro', 'CSS', 'UX'],
    href: '#contact',
  },
  {
    number: '03',
    title: 'Project Three',
    description: 'Add a project that demonstrates range, curiosity, or an interesting technical challenge.',
    tags: ['Node.js', 'Cloud', 'Testing'],
    href: '#contact',
  },
];

const skills = ['TypeScript', 'JavaScript', 'React', 'Astro', 'Node.js', 'Python', 'Git', 'UI engineering'];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="RJ Colarina — Software Engineer building thoughtful digital experiences." />
    <title>RJ Colarina — Software Engineer</title>
  </head>
  <body>
    <div class="noise" aria-hidden="true"></div>
    <header class="site-header">
      <a class="logo" href="#top" aria-label="RJ Colarina home">RJ<span>.</span></a>
      <nav aria-label="Main navigation">
        <a href="#about">About</a>
        <a href="#projects">Projects</a>
        <a href="#experience">Experience</a>
        <a href="#contact">Contact</a>
      </nav>
      <a class="header-cta" href="#contact">Let's talk <span>↗</span></a>
    </header>

    <main id="top">
      <section class="hero page-width">
        <p class="eyebrow reveal">Software Engineer <span class="dot"></span> Based in the Philippines</p>
        <h1 class="reveal delay-1">Building digital<br /><em>experiences</em> that matter.</h1>
        <div class="hero-bottom reveal delay-2">
          <p class="hero-intro">I turn complex ideas into clear, useful, and memorable products through code and thoughtful design.</p>
          <a class="circle-link" href="#projects" aria-label="Scroll to projects">↓</a>
        </div>
        <div class="hero-orb" aria-hidden="true"><span></span></div>
      </section>

      <section class="marquee" aria-label="Areas of expertise">
        <div class="marquee-track"><span>Code with intent</span><b>✳</b><span>Design with feeling</span><b>✳</b><span>Ship with care</span><b>✳</b><span>Code with intent</span><b>✳</b></div>
      </section>

      <section id="about" class="section page-width split-section">
        <p class="section-label">01 / About</p>
        <div class="section-content">
          <h2>Curious by nature.<br /><span>Intentional by craft.</span></h2>
          <p class="large-copy">I'm RJ, a software engineer who enjoys working where technology, design, and human needs meet. I care about the details that make a product feel effortless.</p>
          <p class="muted-copy">When I'm not building, I'm usually learning something new, refining an idea, or looking for a better way to make things work.</p>
        </div>
      </section>

      <section id="projects" class="section page-width">
        <div class="section-heading"><p class="section-label">02 / Selected work</p><p class="muted-copy">A few things I've made</p></div>
        <div class="project-grid">
          {projects.map((project) => (
            <a class="project-card" href={project.href}>
              <div class="project-top"><span>{project.number}</span><span class="arrow">↗</span></div>
              <div><h3>{project.title}</h3><p>{project.description}</p><div class="tags">{project.tags.map((tag) => <span>{tag}</span>)}</div></div>
            </a>
          ))}
        </div>
      </section>

      <section id="skills" class="section page-width split-section skills-section">
        <p class="section-label">03 / Toolkit</p>
        <div class="section-content"><h2>Tools for turning<br /><span>ideas into reality.</span></h2><div class="skill-list">{skills.map((skill, index) => <span><small>0{index + 1}</small>{skill}</span>)}</div></div>
      </section>

      <section id="experience" class="section page-width split-section experience-section">
        <p class="section-label">04 / Experience</p>
        <div class="section-content experience-list">
          <article><div><h3>Software Engineer</h3><p class="muted-copy">Your Company / Organization</p></div><time>2024 — Present</time></article>
          <article><div><h3>Developer</h3><p class="muted-copy">Previous Company / Organization</p></div><time>2022 — 2024</time></article>
          <p class="muted-copy edit-note">Replace these placeholders with your real experience.</p>
        </div>
      </section>

      <section id="contact" class="contact page-width">
        <p class="section-label">05 / Contact</p>
        <h2>Have an idea?<br /><em>Let's make it real.</em></h2>
        <a class="email-link" href="mailto:your.email@example.com">your.email@example.com <span>↗</span></a>
      </section>
    </main>

    <footer class="site-footer page-width"><span>© {new Date().getFullYear()} RJ Colarina</span><div><a href="https://github.com/Qoqqa">GitHub</a><a href="#top">Back to top ↑</a></div></footer>
  </body>
</html>

<style>
@import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Manrope:wght@400;500;600;700;800&display=swap');
:root{--bg:#101010;--surface:#181818;--text:#f1eee8;--muted:#99958d;--line:#30302d;--accent:#d8f36a;--serif:Georgia,serif}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--bg);color:var(--text);font-family:Manrope,Arial,sans-serif;overflow-x:hidden}.noise{position:fixed;inset:0;pointer-events:none;opacity:.035;z-index:5;background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.8' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E")}.page-width{width:min(1160px,calc(100% - 64px));margin-inline:auto}.site-header{height:88px;display:flex;align-items:center;justify-content:space-between;width:min(1280px,calc(100% - 64px));margin:auto}.logo{font-size:1.6rem;font-weight:800;letter-spacing:-.08em;color:var(--text);text-decoration:none}.logo span,.arrow,.email-link span{color:var(--accent)}nav{display:flex;gap:32px}a{color:inherit}nav a,.header-cta,.site-footer a{font:500 .68rem 'DM Mono',monospace;text-transform:uppercase;letter-spacing:.08em;text-decoration:none}.header-cta{border:1px solid var(--line);border-radius:100px;padding:12px 16px}.header-cta span{color:var(--accent);font-size:1rem;margin-left:10px}.hero{min-height:680px;padding-top:120px;position:relative}.eyebrow,.section-label{font:500 .68rem 'DM Mono',monospace;text-transform:uppercase;letter-spacing:.12em;color:var(--muted)}.dot{display:inline-block;width:6px;height:6px;background:var(--accent);border-radius:50%;margin:0 12px 1px}.hero h1{font-size:clamp(3.2rem,8vw,7.8rem);line-height:.98;letter-spacing:-.085em;max-width:920px;margin:34px 0 48px;position:relative;z-index:1}.hero h1 em,.contact h2 em{font-family:var(--serif);font-weight:400;letter-spacing:-.08em}.hero-bottom{display:flex;align-items:center;justify-content:space-between;max-width:650px}.hero-intro{color:var(--muted);font-size:1rem;line-height:1.6;max-width:360px}.circle-link{border:1px solid var(--line);border-radius:50%;display:grid;place-items:center;width:64px;height:64px;text-decoration:none;font-size:1.4rem;transition:.3s}.circle-link:hover{background:var(--accent);color:var(--bg);transform:rotate(-45deg)}.hero-orb{position:absolute;right:5%;top:190px;width:280px;height:280px;border-radius:50%;background:radial-gradient(circle at 30% 25%,#d8f36a,transparent 15%),radial-gradient(circle at 70% 70%,#7044b8,transparent 52%),#292029;filter:blur(.2px);opacity:.8;animation:float 7s ease-in-out infinite}.hero-orb span{display:block;width:100%;height:100%;border:1px solid #d8f36a55;border-radius:50%;transform:scale(1.15)}.marquee{border-block:1px solid var(--line);overflow:hidden;padding:18px 0;color:var(--accent);font:500 .7rem 'DM Mono',monospace;text-transform:uppercase;letter-spacing:.15em}.marquee-track{display:flex;justify-content:space-around;min-width:850px;animation:slide 22s linear infinite}.marquee b{font-size:1rem}.section{padding-block:140px;border-bottom:1px solid var(--line)}.split-section{display:grid;grid-template-columns:25% 1fr;gap:40px}.section-content{max-width:750px}.section-content h2,.contact h2{font-size:clamp(2.4rem,5vw,5rem);line-height:1.02;letter-spacing:-.07em;margin:0 0 40px}.section-content h2 span{color:var(--muted)}.large-copy{font-size:1.35rem;line-height:1.5;max-width:620px}.muted-copy{color:var(--muted);line-height:1.7}.section-heading{display:flex;justify-content:space-between;align-items:start;margin-bottom:42px}.section-heading .muted-copy{margin:0}.project-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.project-card{background:var(--surface);min-height:350px;padding:24px;display:flex;flex-direction:column;justify-content:space-between;text-decoration:none;transition:transform .35s,background .35s}.project-card:hover{transform:translateY(-8px);background:#222}.project-top{display:flex;justify-content:space-between;color:var(--muted);font:500 .7rem 'DM Mono',monospace}.project-card h3{font-size:1.65rem;letter-spacing:-.05em;margin:0 0 12px}.project-card p{color:var(--muted);font-size:.9rem;line-height:1.6;margin:0 0 22px}.tags{display:flex;gap:6px;flex-wrap:wrap}.tags span{border:1px solid var(--line);border-radius:100px;padding:6px 9px;color:var(--muted);font:500 .6rem 'DM Mono',monospace}.skill-list{display:grid;grid-template-columns:1fr 1fr;border-top:1px solid var(--line)}.skill-list span{padding:18px 0;border-bottom:1px solid var(--line);font-size:1.1rem}.skill-list small{font:500 .65rem 'DM Mono',monospace;color:var(--accent);margin-right:18px}.experience-list article{border-top:1px solid var(--line);padding:24px 0;display:flex;justify-content:space-between}.experience-list h3{margin:0 0 6px;font-size:1.2rem}.experience-list time{color:var(--muted);font:500 .7rem 'DM Mono',monospace}.edit-note{font-size:.8rem;margin-top:30px}.contact{padding-block:180px}.contact h2{font-size:clamp(3.5rem,9vw,9rem);margin-block:35px 70px}.email-link{font:500 clamp(1rem,2vw,1.4rem) 'DM Mono',monospace;text-decoration:none;border-bottom:1px solid var(--accent);padding-bottom:10px}.email-link span{margin-left:20px}.site-footer{display:flex;justify-content:space-between;padding-block:28px;color:var(--muted);font:500 .65rem 'DM Mono',monospace;text-transform:uppercase;letter-spacing:.08em}.site-footer div{display:flex;gap:24px}.reveal{animation:appear .8s both}.delay-1{animation-delay:.15s}.delay-2{animation-delay:.3s}@keyframes appear{from{opacity:0;transform:translateY(25px)}to{opacity:1;transform:none}}@keyframes float{50%{transform:translateY(-18px) rotate(8deg)}}@keyframes slide{to{transform:translateX(-25%)}}@media(max-width:760px){.page-width,.site-header{width:calc(100% - 40px)}.site-header{height:72px}nav{display:none}.header-cta{padding:10px 12px}.hero{padding-top:90px;min-height:620px}.hero-orb{width:160px;height:160px;top:270px;right:0;opacity:.5}.hero h1{font-size:clamp(3.1rem,15vw,5rem);margin-top:28px}.hero-bottom{align-items:flex-end}.section{padding-block:90px}.split-section{grid-template-columns:1fr;gap:35px}.section-label{margin:0}.project-grid{grid-template-columns:1fr}.project-card{min-height:290px}.contact{padding-block:110px}.contact h2{font-size:clamp(3.5rem,16vw,6rem);margin-block:25px 55px}.site-footer{display:block}.site-footer div{margin-top:18px}}
</style>
